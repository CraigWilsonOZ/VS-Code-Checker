dist/
build/

# VS Code Checker - generated outputs (keep folders, ignore data)
reports/*
!reports/.gitkeep
*.json
*.html

# User config (contains local paths and tokens - do not commit)
config.yaml

# Extension export archives (keep folder, ignore contents)
vscode-extensions-export/*
!vscode-extensions-export/.gitkeep
*.vsix

# Environment files
.env
.env.*

# OS
.DS_Store
Thumbs.db

# vscode settings
.vscode/
settings.json

